{
  "name": "start-web-platform",
  "version": "1.0.1",
  "description": "搭建 web 平台的脚手架，前后端分离 Ant Design Pro + Koa",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "dev": "nodemon main.js",
    "test": "mocha --require ./test-setup.js tests/**/*.test.js",
    "generate-rsa-keys": "node scripts/generate-rsa-keys.js",
    "start2": "node --security-revert=CVE-2023-46809 main.js",
    "dev2": "nodemon --security-revert=CVE-2023-46809 main.js",
    "test2": "mocha --node-option security-revert=CVE-2023-46809 --require ./test-setup.js tests/**/*.test.js",
    "generate-rsa-keys2": "node --security-revert=CVE-2023-46809 scripts/generate-rsa-keys.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zxffffffff/start-web-platform.git"
  },
  "keywords": [
    "nodejs",
    "platform",
    "koa",
    "web",
    "starter",
    "antd-design-pro"
  ],
  "author": "zxffffffff",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zxffffffff/start-web-platform/issues"
  },
  "homepage": "https://github.com/zxffffffff/start-web-platform#readme",
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^13.1.1",
    "jsencrypt": "^3.3.2",
    "koa": "^3.0.0",
    "koa-body": "^6.0.1",
    "koa-static": "^5.0.0",
    "ldapjs": "^3.0.7",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "chai": "^4.3.7",
    "mocha": "^10.2.0",
    "nodemon": "^3.1.10",
    "sinon": "^21.0.0",
    "supertest": "^6.3.3"
  }
